# Module declarations and the include-graph rule.
#
# Each module is one static library `mso_<module>`: sources in src/<module>/, headers in
# include/mso/<module>/ (internal ones in include/mso/<module>/detail/). A module declares the modules it
# builds on with MODULES; that list is both its link dependencies and the only modules (plus their own
# dependencies, transitively) whose headers it may include. The rule is checked by the `include-graph`
# CTest entry (cmake/CheckIncludeGraph.cmake), so a sideways or upward include fails the test run
# instead of silently compiling through the shared include/ root.
#
# Why a check rather than per-module include roots: every module shares the include/ root because the
# header layout is `include/mso/<module>/` (AGENTS.md rule 4). Giving each module its own root would
# mean moving every header into `include/<module>/mso/<module>/` and changing every include in the
# tree, and it still would not stop a module from reaching a transitive dependency's headers it never
# declared. The check enforces exactly the declared graph with no file moves.

define_property(GLOBAL PROPERTY MSO_MODULES BRIEF_DOCS "Declared first-party modules")

# Records the modules `module` builds on (for the include-graph check) without creating a target.
# Used directly for executables (ui, worker) and by mso_module() for libraries.
function(mso_declare_module module)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "" "" "MODULES")
  set_property(GLOBAL APPEND PROPERTY MSO_MODULES ${module})
  set_property(GLOBAL PROPERTY MSO_MODULE_USES_${module} ${ARG_MODULES})
endfunction()

# Declares the static library mso_<module> from src/<module>/*.cpp.
#   MODULES  first-party modules it builds on (linked PUBLIC: their headers appear in its headers)
#   PUBLIC   further PUBLIC link libraries (vendored targets whose types appear in public headers)
#   PRIVATE  PRIVATE link libraries (implementation-only vendored targets)
#   EXCLUDE  source file names (relative to src/<module>/) that belong to an executable instead
function(mso_module module)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "" "" "MODULES;PUBLIC;PRIVATE;EXCLUDE")
  file(GLOB sources CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/src/${module}/*.cpp")
  foreach(excluded IN LISTS ARG_EXCLUDE)
    list(REMOVE_ITEM sources "${PROJECT_SOURCE_DIR}/src/${module}/${excluded}")
  endforeach()
  list(TRANSFORM ARG_MODULES PREPEND "mso_" OUTPUT_VARIABLE module_targets)
  if(sources)
    add_library(mso_${module} STATIC ${sources})
    target_include_directories(mso_${module} PUBLIC "${PROJECT_SOURCE_DIR}/include")
    target_link_libraries(mso_${module} PUBLIC ${module_targets} ${ARG_PUBLIC} PRIVATE ${ARG_PRIVATE})
    mso_apply_options(mso_${module})
  else()
    # Headers only (so far): an INTERFACE library keeps the module linkable by name.
    add_library(mso_${module} INTERFACE)
    target_include_directories(mso_${module} INTERFACE "${PROJECT_SOURCE_DIR}/include")
    target_link_libraries(mso_${module} INTERFACE ${module_targets} ${ARG_PUBLIC})
  endif()
  mso_declare_module(${module} MODULES ${ARG_MODULES})
endfunction()

# Writes the declared graph (each module with the transitive closure of what it may include) for the
# include-graph check and registers that check with CTest. Call once, after every module is declared.
function(mso_finalize_module_graph)
  get_property(modules GLOBAL PROPERTY MSO_MODULES)
  set(graph_file "${PROJECT_BINARY_DIR}/mso_include_graph.cmake")
  set(content "# Generated by cmake/Modules.cmake: modules and the modules each may include.\n")
  string(APPEND content "set(MSO_GRAPH_MODULES \"${modules}\")\n")
  foreach(module IN LISTS modules)
    set(allowed ${module})
    get_property(pending GLOBAL PROPERTY MSO_MODULE_USES_${module})
    while(pending)
      list(POP_FRONT pending dependency)
      if(NOT dependency IN_LIST modules)
        message(FATAL_ERROR "Module '${module}' builds on undeclared module '${dependency}'")
      endif()
      if(NOT dependency IN_LIST allowed)
        list(APPEND allowed ${dependency})
        get_property(next GLOBAL PROPERTY MSO_MODULE_USES_${dependency})
        list(APPEND pending ${next})
      endif()
    endwhile()
    string(APPEND content "set(MSO_GRAPH_ALLOWED_${module} \"${allowed}\")\n")
  endforeach()
  file(CONFIGURE OUTPUT "${graph_file}" CONTENT "${content}" @ONLY)
  if(MSO_BUILD_TESTS)
    add_test(NAME include-graph
             COMMAND ${CMAKE_COMMAND} -DMSO_SOURCE_DIR=${PROJECT_SOURCE_DIR} -DMSO_GRAPH_FILE=${graph_file}
                     -P ${PROJECT_SOURCE_DIR}/cmake/CheckIncludeGraph.cmake)
    set_tests_properties(include-graph PROPERTIES LABELS "lint" TIMEOUT 60)
  endif()
endfunction()
