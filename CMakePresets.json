{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "clang-libcxx-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS_INIT": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-stdlib=libc++"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (clang + libc++)",
      "inherits": "clang-libcxx-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release (clang + libc++)",
      "inherits": "clang-libcxx-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "MSO_WARNINGS_AS_ERRORS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
