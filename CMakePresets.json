{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "clang-libcxx-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS_INIT": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-stdlib=libc++"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (clang + libc++, libc++ debug hardening)",
      "inherits": "clang-libcxx-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release with debug info (clang + libc++, -Werror)",
      "description": "Optimized build that keeps symbols (RelWithDebInfo) so crashes and profiles stay readable.",
      "inherits": "clang-libcxx-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "MSO_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "sanitize",
      "displayName": "Debug + AddressSanitizer + UndefinedBehaviorSanitizer (-Werror)",
      "inherits": "clang-libcxx-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MSO_SANITIZERS": "address;undefined",
        "MSO_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer targets (optimized + AddressSanitizer + UndefinedBehaviorSanitizer, -Werror)",
      "description": "Builds only the libraries and the fuzz targets in tests/fuzz (no tests, no desktop app). Run them with tools/run_fuzzers.py.",
      "inherits": "clang-libcxx-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MSO_SANITIZERS": "address;undefined",
        "MSO_BUILD_FUZZERS": "ON",
        "MSO_BUILD_TESTS": "OFF",
        "MSO_BUILD_GUI": "OFF",
        "MSO_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI: release; Qt GUI and FFmpeg required",
      "inherits": "release",
      "cacheVariables": { "MSO_REQUIRE_GUI": "ON", "MSO_REQUIRE_FFMPEG": "ON" }
    },
    {
      "name": "ci-debug",
      "displayName": "CI: debug (libc++ debug hardening) with -Werror; Qt GUI and FFmpeg required",
      "inherits": "debug",
      "cacheVariables": { "MSO_WARNINGS_AS_ERRORS": "ON", "MSO_REQUIRE_GUI": "ON", "MSO_REQUIRE_FFMPEG": "ON" }
    },
    {
      "name": "ci-sanitize",
      "displayName": "CI: sanitize; Qt GUI and FFmpeg required",
      "inherits": "sanitize",
      "cacheVariables": { "MSO_REQUIRE_GUI": "ON", "MSO_REQUIRE_FFMPEG": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "sanitize", "configurePreset": "sanitize" },
    { "name": "fuzz", "configurePreset": "fuzz", "targets": ["fuzzers"] },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "ci-debug", "configurePreset": "ci-debug" },
    { "name": "ci-sanitize", "configurePreset": "ci-sanitize" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "debug", "inherits": "test-base", "configurePreset": "debug" },
    { "name": "release", "inherits": "test-base", "configurePreset": "release" },
    { "name": "sanitize", "inherits": "test-base", "configurePreset": "sanitize" },
    { "name": "ci", "inherits": "test-base", "configurePreset": "ci" },
    { "name": "ci-debug", "inherits": "test-base", "configurePreset": "ci-debug" },
    { "name": "ci-sanitize", "inherits": "test-base", "configurePreset": "ci-sanitize" }
  ]
}
